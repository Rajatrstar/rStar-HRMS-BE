						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Every endpoint answers in the same envelope - see 'Response contract'",
									"// in the README. Asserting it here means a regression shows up on any",
									"// request, not just the one somebody remembered to check.",
									"pm.test('envelope is well formed', () => {",
									"  const body = pm.response.json();",
									"  pm.expect(body).to.have.property('success');",
									"  pm.expect(body).to.have.property('statusCode', pm.response.code);",
									"  pm.expect(body).to.have.property('message');",
									"  pm.expect(body).to.have.property('data');",
									"  pm.expect(body.success).to.eql(pm.response.code < 400);",
									"});",
									"",
									"pm.test('login completes', () => pm.response.to.have.status(200));",
									"",
									"// `data` is NOT a safe name here: the Postman sandbox predeclares it for",
									"// the current data-file row, so `const data = ...` is a redeclaration and",
									"// the whole script dies with a SyntaxError before a single test runs.",
									"const payload = pm.response.json().data;",
									"",
									"// This is what removes the copy-paste.",
									"pm.collectionVariables.set('accessToken', payload.accessToken);",
									"pm.collectionVariables.set('refreshToken', payload.refreshToken);",
									"pm.collectionVariables.set('otp', '');",
									"",
									"pm.test('tokens stored', () => {",
									"  pm.expect(payload.accessToken).to.be.a('string').and.not.empty;",
									"  pm.expect(payload.refreshToken).to.be.a('string').and.not.empty;",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"auth": {
							"type": "noauth"
						},
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"otp\": \"{{otp}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/verify-otp",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"verify-otp"
							]
						},
						"description": "Step 2: checks the OTP and returns the token pair. Stores both tokens."
					}
				},
