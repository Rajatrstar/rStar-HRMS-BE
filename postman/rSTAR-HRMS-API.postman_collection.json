	"item": [
		{
			"name": "Health",
			"description": "No auth. Readiness answers 503 when the database is unreachable, which is a real answer rather than a transport failure.",
			"item": [
				{
					"name": "1. health",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Every endpoint answers in the same envelope - see 'Response contract'",
									"// in the README. Asserting it here means a regression shows up on any",
									"// request, not just the one somebody remembered to check.",
									"pm.test('envelope is well formed', () => {",
									"  const body = pm.response.json();",
									"  pm.expect(body).to.have.property('success');",
									"  pm.expect(body).to.have.property('statusCode', pm.response.code);",
									"  pm.expect(body).to.have.property('message');",
									"  pm.expect(body).to.have.property('data');",
									"  pm.expect(body.success).to.eql(pm.response.code < 400);",
									"});",
									"",
									"pm.test('up', () => pm.response.to.have.status(200));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"auth": {
							"type": "noauth"
						},
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"health"
							]
						},
						"description": "Liveness. No auth."
					}
				},
				{
					"name": "2. health/ready",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Every endpoint answers in the same envelope - see 'Response contract'",
									"// in the README. Asserting it here means a regression shows up on any",
									"// request, not just the one somebody remembered to check.",
									"pm.test('envelope is well formed', () => {",
									"  const body = pm.response.json();",
									"  pm.expect(body).to.have.property('success');",
									"  pm.expect(body).to.have.property('statusCode', pm.response.code);",
									"  pm.expect(body).to.have.property('message');",
									"  pm.expect(body).to.have.property('data');",
									"  pm.expect(body.success).to.eql(pm.response.code < 400);",
									"});",
									"",
									"// 200 when the database answers, 503 when it does not. Both are a",
									"// valid reply from a working process, so neither is a failure here.",
									"pm.test('reports a readiness verdict', () => {",
									"  pm.expect(pm.response.code).to.be.oneOf([200, 503]);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"auth": {
							"type": "noauth"
						},
						"url": {
							"raw": "{{baseUrl}}/health/ready",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"health",
								"ready"
							]
						},
						"description": "Readiness: 200 when the database is reachable, 503 when it is not. A load balancer reads the status code; the degraded reply puts the detail in `details` rather than `data`."
					}
				}
			]
		},
		{
			"name": "Auth",
			"description": "Login is two steps: the password is checked first, then a one-time code.\n\nRun these top to bottom once per session. `verify-otp` captures {{accessToken}} and {{refreshToken}}, and every other folder inherits the collection Bearer auth that reads them - nothing is ever pasted.\n\nforgot-password / reset-password really do change a password. They are last for that reason.",
			"item": [
				{
					"name": "1. login",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Every endpoint answers in the same envelope - see 'Response contract'",
									"// in the README. Asserting it here means a regression shows up on any",
									"// request, not just the one somebody remembered to check.",
									"pm.test('envelope is well formed', () => {",
									"  const body = pm.response.json();",
									"  pm.expect(body).to.have.property('success');",
									"  pm.expect(body).to.have.property('statusCode', pm.response.code);",
									"  pm.expect(body).to.have.property('message');",
									"  pm.expect(body).to.have.property('data');",
									"  pm.expect(body.success).to.eql(pm.response.code < 400);",
									"});",
									"",
									"pm.test('password accepted', () => pm.response.to.have.status(200));",
									"",
									"// `data` is NOT a safe name here: the Postman sandbox predeclares it for",
									"// the current data-file row, so `const data = ...` is a redeclaration and",
									"// the whole script dies with a SyntaxError before a single test runs.",
									"const payload = pm.response.json().data;",
									"",
									"// The OTP comes back only when the server has OTP_IN_RESPONSE=true",
									"// (development only). Otherwise read it from the server log and set",
									"// the `otp` variable yourself.",
									"if (payload.otp) {",
									"  pm.collectionVariables.set('otp', payload.otp);",
									"  console.log('OTP captured:', payload.otp);",
									"} else {",
									"  console.warn('No OTP in response - set OTP_IN_RESPONSE=true or fill {{otp}} by hand.');",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"auth": {
							"type": "noauth"
						},
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Step 1: checks email + password, then issues an OTP."
					}
				},
				{
					"name": "2. resend-otp",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Every endpoint answers in the same envelope - see 'Response contract'",
									"// in the README. Asserting it here means a regression shows up on any",
									"// request, not just the one somebody remembered to check.",
									"pm.test('envelope is well formed', () => {",
									"  const body = pm.response.json();",
									"  pm.expect(body).to.have.property('success');",
									"  pm.expect(body).to.have.property('statusCode', pm.response.code);",
									"  pm.expect(body).to.have.property('message');",
									"  pm.expect(body).to.have.property('data');",
									"  pm.expect(body.success).to.eql(pm.response.code < 400);",
									"});",
									"",
									"pm.test('a fresh OTP was issued', () => pm.response.to.have.status(200));",
									"",
									"// `data` is NOT a safe name here: the Postman sandbox predeclares it for",
									"// the current data-file row, so `const data = ...` is a redeclaration and",
									"// the whole script dies with a SyntaxError before a single test runs.",
									"const payload = pm.response.json().data;",
									"",
									"// The resent code REPLACES the one login issued, so the variable has to",
									"// move with it or verify-otp will submit a code the server has forgotten.",
									"if (payload.otp) {",
									"  pm.collectionVariables.set('otp', payload.otp);",
									"  console.log('OTP replaced with:', payload.otp);",
									"} else {",
									"  console.warn('No OTP in response - the otp variable is now STALE. Read',",
									"               'the new code from the server log before running verify-otp.');",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"auth": {
							"type": "noauth"
						},
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{loginEmail}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/resend-otp",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"resend-otp"
							]
						},
						"description": "Issues a fresh OTP for a login already in progress, replacing the one from step 3. Only valid between login and verify-otp - once verify-otp succeeds the code is cleared and this answers 401."
					}
				},
				{
					"name": "3. verify-otp",
