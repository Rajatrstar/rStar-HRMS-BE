# Azure SQL Database. Copy to .env and fill in, or copy the block below into
# the .env you already have. Everything outside the SQL Server block is the
# same as .env.example - this file only covers what changes.
#
# Verify it before starting the API:  npm run db:check

# --- Azure SQL --------------------------------------------------------------
# The logical server's FQDN, exactly as the portal shows it. Recognising
# ".database.windows.net" is how the app knows it is talking to Azure: it then
# requires encryption, waits longer for a connection, and retries the failures
# that Azure produces on its own (see src/config/env.js).
DB_HOST=rstar-hrms.database.windows.net
DB_PORT=1433
DB_NAME=rStarHRMS

# The contained user created by db/azure/001_app_users.sql. Not the server
# administrator: that account can drop the database, and the API never needs
# to. Plain "hrms_app" - the old "user@server" form is for drivers that cannot
# send the database name at login, which tedious does.
DB_USER=hrms_app
DB_PASSWORD=

# Azure accepts nothing but encrypted connections, and its certificate is
# issued by a public CA - so it validates on its own and must not be blindly
# trusted. These are the defaults for an Azure host; the app refuses to start
# if they are set the other way round.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# Optional. The defaults below are already applied for an Azure host; set them
# only to override. A serverless database that has auto-paused takes tens of
# seconds to resume, which is why the first connection is given 30 seconds and
# five attempts rather than failing the boot.
# DB_CONNECTION_TIMEOUT_MS=30000
# DB_REQUEST_TIMEOUT_MS=60000
# DB_CONNECT_RETRIES=5
# DB_POOL_MAX=10

# ---------------------------------------------------------------------------
# Migrations run as a different user
# ---------------------------------------------------------------------------
# hrms_app cannot change the schema by design, so db:migrate is run with the
# deployment account from its own file - keeping it out of .env means the
# running API can never use it:
#
#   cp .env .env.deploy        # then change DB_USER/DB_PASSWORD to hrms_deploy
#   node --env-file=.env.deploy scripts/migrate.js
#
# .env.deploy is git-ignored.
