// HRMS backend data model.
//
// Target: Microsoft SQL Server / Azure SQL.
// Two provider constraints shape this file:
//   1. SQL Server has no native enum type, so Prisma `enum` blocks are unsupported.
//      Role / employment-status columns are plain strings; `src/enums/` is the single
//      source of truth and zod validates them at the request boundary.
//   2. A nonclustered index key is capped at 900 bytes, and an unlengthed Prisma string
//      maps to NVARCHAR(1000) = 2000 bytes. Every unique column therefore declares an
//      explicit @db.NVarChar length.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlserver"
}

/// Authentication identity. Not every Employee has one (e.g. pre-boarding records).
model User {
  id                  String    @id @default(uuid(7)) @db.NVarChar(36)
  email               String    @unique @db.NVarChar(190)
  passwordHash        String    @db.NVarChar(255)
  /// One of enums/role.enum.ts -> Role
  role                String    @db.NVarChar(32)
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  employee      Employee?
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@index([role])
  @@map("users")
}

/// One row per issued refresh token. The raw token is never stored - only its SHA-256
/// digest - so a database leak cannot be replayed against the API. Rotation chains rows
/// via `replacedById`, which is what makes reuse detection possible.
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.NVarChar(36)
  userId       String    @db.NVarChar(36)
  tokenHash    String    @unique @db.NVarChar(64)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.NVarChar(36)
  userAgent    String?   @db.NVarChar(255)
  ipAddress    String?   @db.NVarChar(45)
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Reference CRUD module. New HRMS modules should follow this shape:
/// soft delete via `deletedAt`, a stable business key, and indexed filter columns.
model Employee {
  id               String    @id @default(uuid(7)) @db.NVarChar(36)
  employeeCode     String    @unique @db.NVarChar(32)
  firstName        String    @db.NVarChar(80)
  lastName         String    @db.NVarChar(80)
  workEmail        String    @unique @db.NVarChar(190)
  phone            String?   @db.NVarChar(20)
  department       String    @db.NVarChar(80)
  designation      String    @db.NVarChar(80)
  dateOfJoining    DateTime  @db.Date
  /// One of enums/employment-status.enum.ts -> EmploymentStatus
  employmentStatus String    @db.NVarChar(32)
  managerId        String?   @db.NVarChar(36)
  userId           String?   @unique @db.NVarChar(36)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user    User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  // NoAction is mandatory on a SQL Server self-relation; anything else is rejected as a
  // cascade cycle. Orphaned reports are re-pointed in the service layer instead.
  manager Employee?  @relation("EmployeeReportsTo", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reports Employee[] @relation("EmployeeReportsTo")

  @@index([department])
  @@index([employmentStatus])
  @@index([deletedAt])
  @@map("employees")
}

/// Append-only trail for sensitive operations. Written by the service layer, never updated.
model AuditLog {
  id        String   @id @default(uuid(7)) @db.NVarChar(36)
  actorId   String?  @db.NVarChar(36)
  action    String   @db.NVarChar(64)
  entity    String   @db.NVarChar(64)
  entityId  String?  @db.NVarChar(36)
  metadata  String?  @db.NVarChar(Max)
  ipAddress String?  @db.NVarChar(45)
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}
