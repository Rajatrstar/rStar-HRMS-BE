{
  "name": "rstar-hrms-be",
  "version": "0.1.0",
  "private": true,
  "description": "rSTAR HRMS backend API",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nodemon",
    "start": "node --env-file-if-exists=.env src/index.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "db:seed:employees": "node --env-file-if-exists=.env scripts/seed-employees.js",
    "db:seed:permissions": "node --env-file-if-exists=.env scripts/seed-permissions.js",
    "db:create:admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "dev:node": "node --watch --env-file-if-exists=.env src/index.js",
    "mail:test": "node --env-file-if-exists=.env scripts/send-test-email.js",
    "db:verify": "node --env-file-if-exists=.env scripts/verify-schema.js"
  },
  "dependencies": {
    "@node-rs/bcrypt": "^2.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "mssql": "^12.7.6",
    "nodemailer": "^10.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
