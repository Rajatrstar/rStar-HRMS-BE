# Copy to .env and fill in real values. .env is git-ignored.

NODE_ENV=development
PORT=5000

# --- SQL Server -------------------------------------------------------------
# Use the host + port, NOT the named instance ("DESKTOP-K5BVVL6\SQLEXPRESS").
# Named-instance resolution needs the SQL Server Browser service on UDP 1434;
# it is Stopped/Disabled on this machine, so instance names time out.
# Find the port with: SQL Server Configuration Manager > TCP/IP > IP Addresses > IPAll.
DB_HOST=localhost
DB_PORT=1433
DB_NAME=rStarHRMS
DB_USER=sa
DB_PASSWORD=your-password-here

# encrypt=true is the driver default; the local instance uses a self-signed
# certificate, so the connection also trusts the server certificate.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Pointing at Azure SQL? Use .env.azure.example instead of this block. A
# DB_HOST ending in .database.windows.net switches the app to Azure defaults
# on its own - encryption required, longer timeouts, transient failures
# retried - and it refuses to start with DB_TRUST_SERVER_CERTIFICATE=true,
# which against Azure disables a check that would otherwise catch an
# intercepted connection.

# Optional, both targets. The defaults are 15s/30s locally and 30s/60s with
# five connect attempts against Azure.
# DB_CONNECTION_TIMEOUT_MS=15000
# DB_REQUEST_TIMEOUT_MS=30000
# DB_CONNECT_RETRIES=1
# DB_POOL_MAX=10

# Apply db/migrations at startup, so an empty database builds itself on first
# boot and a new migration lands on the next restart. On by default. Set it to
# false where something else owns the schema - a CI deploy stage, or a DBA.
# The login needs db_ddladmin; on Azure see db/azure/002_grant_schema_rights.sql.
DB_AUTO_MIGRATE=true

# Comma-separated list of allowed browser origins, or * for any.
CORS_ORIGIN=*

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cost factor for bcrypt. Higher is slower to crack and slower to log in.
BCRYPT_SALT_ROUNDS=12

# Second factor issued after the password check succeeds.
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10

# Development convenience: return the OTP in the login response so Postman and
# scripts can finish a login without reading the server log. NEVER enable this
# on a deployed server - it is also hard-ignored when NODE_ENV=production.
OTP_IN_RESPONSE=false

# Development shortcut. With DefaultOTP=true every OTP issued is
# DEFAULT_OTP_CODE and NO email is queued or sent to anybody - neither login
# codes nor password resets - so the whole flow works on a machine with no
# mailbox. With DefaultOTP=false (the default) real random codes are generated
# and mail is sent normally.
#
# Like OTP_IN_RESPONSE this is ignored outright when NODE_ENV=production: a
# fixed second factor is no second factor at all.
#
# DEFAULT_OTP_CODE must be exactly OTP_LENGTH digits or the server refuses to
# start - the login endpoint validates length before it compares anything.
DefaultOTP=true
DEFAULT_OTP_CODE=123456

# --- Rate limiting ----------------------------------------------------------
# Three tiers, all counted over the same window:
#   RATE_LIMIT_MAX             per IP, every endpoint
#   RATE_LIMIT_AUTH_MAX        per IP, /auth only - keep this generous, an
#                              office behind one NAT address shares the bucket
#   RATE_LIMIT_CREDENTIAL_MAX  per ACCOUNT (email), endpoints that check a
#                              password or an OTP - only FAILED attempts count
#   RATE_LIMIT_OTP_SEND_MAX    per ACCOUNT (email), endpoints that send mail -
#                              every request counts, successful ones included
#
# The per-account tiers are what stop a 6-digit OTP being brute forced: an
# attacker who rotates IP addresses still gets RATE_LIMIT_CREDENTIAL_MAX
# guesses per window against any one account.
#
# Health checks are exempt, so a load balancer polling /health cannot exhaust
# the budget for real traffic.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=300
RATE_LIMIT_CREDENTIAL_MAX=5
RATE_LIMIT_OTP_SEND_MAX=3

# --- Access control ---------------------------------------------------------
# A resolved permission set is cached per employee. Writes through the admin
# API invalidate it immediately on the instance that made the change; other
# instances notice within the stamp poll interval.
#
# Set ACCESS_CONTROL_CACHE_ENABLED=false to make every check hit the database -
# the fastest way to tell a permissions bug from a cache bug.
ACCESS_CONTROL_CACHE_ENABLED=true
ACCESS_CONTROL_CACHE_TTL_SECONDS=60
ACCESS_CONTROL_CACHE_MAX_ENTRIES=1000
ACCESS_CONTROL_STAMP_POLL_SECONDS=5

# ---------------------------------------------------------------------------
# Outbound email (Microsoft 365 / Outlook)
# ---------------------------------------------------------------------------
# Leave MAIL_ENABLED=false and the credentials blank to develop without a
# mailbox: mail is still queued into dbo.EmailOutbox and the worker writes the
# rendered message to the server log instead of delivering it.
#
# Three things make a correct-looking password fail against Office 365:
#   1. SMTP AUTH is disabled on the mailbox. An admin enables it with
#      Set-CASMailbox -Identity <mailbox> -SmtpClientAuthenticationDisabled $false
#   2. The mailbox has MFA. Basic auth cannot satisfy it - use an app password
#      if the tenant allows one, otherwise OAuth2 is the only way.
#   3. MAIL_FROM_ADDRESS is not the authenticated mailbox and has no Send As
#      permission. Leave it blank to send as MAIL_USER.
#
# Shelf life: Microsoft disables SMTP basic authentication by default for
# existing tenants at the end of December 2026 (admins can re-enable), and
# tenants created after that cannot use it at all. The swap to OAuth2 is
# confined to the auth block in src/utils/mailer.js.
MAIL_ENABLED=false
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
# false = STARTTLS on 587. Set true only for implicit TLS on port 465.
MAIL_SECURE=false
# The full mailbox address that authenticates to SMTP - not an alias, not just
# the user part.            e.g. MAIL_USER=hrms-noreply@rstartec.com
MAIL_USER=
# The mailbox password, or an app password when the mailbox has MFA. Quote it
# if it contains # or spaces.    e.g. MAIL_PASSWORD="k7Rq-2xVt-9Bmn-4Dzs"
MAIL_PASSWORD=
# Display name recipients see.   e.g. MAIL_FROM_NAME=rSTAR HRMS
MAIL_FROM_NAME=rSTAR HRMS
# Blank means "same as MAIL_USER". Set it only when the mailbox has Send As
# permission for that address.   e.g. MAIL_FROM_ADDRESS=hr@rstartec.com
MAIL_FROM_ADDRESS=

# Outbox worker: how often it drains the queue and how hard it retries.
MAIL_POLL_SECONDS=15
MAIL_BATCH_SIZE=25
MAIL_MAX_ATTEMPTS=5
