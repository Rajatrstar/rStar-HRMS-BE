# Copy to .env and fill in. .env is gitignored - never commit real credentials.

NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------------
# Microsoft SQL Server / Azure SQL.
# The Prisma MSSQL adapter has no `instanceName` support, so a named instance such as
# SQLEXPRESS must be addressed as host:port (it listens on 1433 here).
# It also has no Windows integrated auth - a SQL login is required.
# Azure SQL: encrypt=true and trustServerCertificate=false.
DATABASE_URL="sqlserver://localhost:1433;database=rSTAR_HRMS_BE;user=CHANGE_ME;password=CHANGE_ME;encrypt=true;trustServerCertificate=true"

# --- JWT ----------------------------------------------------------------------
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The two secrets must be different.
JWT_ACCESS_SECRET=CHANGE_ME_min_32_chars_access_secret_value
JWT_REFRESH_SECRET=CHANGE_ME_min_32_chars_refresh_secret_value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=rstar-hrms
JWT_AUDIENCE=rstar-hrms-api

# --- HTTP security ------------------------------------------------------------
# Comma-separated allowlist. Leave empty to block all cross-origin browser requests.
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
# Number of trusted reverse proxies. 0 locally, 1 behind Azure App Service.
TRUST_PROXY_HOPS=0

# --- Account lockout ----------------------------------------------------------
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=15

SHUTDOWN_TIMEOUT_MS=10000

# --- Seed (npm run db:seed) ---------------------------------------------------
SEED_ADMIN_EMAIL=admin@rstartec.com
SEED_ADMIN_PASSWORD=CHANGE_ME_min_12_chars
