# Dependencies
node_modules/

# Build output
dist/

# Secrets - never commit. Copy .env.example to .env instead.
.env
.env.*
!.env.example

# Prisma client is regenerated by `npm install` (postinstall) / `npm run prisma:generate`
/src/generated/

# Logs & OS cruft
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/*
!.vscode/extensions.json

# Prisma-vendored agent skill docs, restorable from skills-lock.json.
# .claude/ mirrors .agents/ through symlinks that this Windows checkout cannot
# preserve (core.symlinks=false), so committing both stores every file twice.
.agents/
.claude/
